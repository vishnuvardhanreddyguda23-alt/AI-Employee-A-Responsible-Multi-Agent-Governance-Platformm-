# Copy to .env. Never commit real credentials.

DATABASE_URL=postgresql+psycopg2://ai_employee:change-me@postgres:5432/ai_employee_db
REDIS_URL=redis://redis:6379/0
JWT_SECRET=replace-with-a-long-random-secret
LLM_API_KEY=
MODEL_NAME=demo-deterministic
API_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
ENVIRONMENT=development
DEMO_MODE=true

# Database container defaults
POSTGRES_USER=ai_employee
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ai_employee_db

# Backwards-compatible application settings
APP_ENV=development
SECRET_KEY=replace-with-the-same-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:5173

# Observability / cost thresholds
THRESHOLD_PERFORMANCE_SCORE_MIN=70
THRESHOLD_FAILURE_RATE_MAX=20
THRESHOLD_LATENCY_MS_MAX=5000
THRESHOLD_DAILY_TOKEN_BUDGET=200000
THRESHOLD_DAILY_COST_BUDGET=25
THRESHOLD_MONTHLY_COST_BUDGET=500
THRESHOLD_TOKEN_SPIKE_RATIO=2.5
THRESHOLD_TOKENS_PER_TASK_MAX=8000
